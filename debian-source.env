# Official Debian source selection for the Igorcoin Qortal OS build.
# Debian 13.3 was published on 10 January 2026.
# The following Debian Snapshot timestamp pins the package baseline reproducibly.
DEBIAN_SUITE="${DEBIAN_SUITE:-trixie}"
DEBIAN_POINT_RELEASE="${DEBIAN_POINT_RELEASE:-13.3}"
DEBIAN_SNAPSHOT="${DEBIAN_SNAPSHOT:-20260111T000000Z}"

# Official Debian installer archive supplied as the original project reference.
DEBIAN_INSTALLER_DIRECTORY="https://cdimage.debian.org/cdimage/archive/13.3.0/amd64/iso-cd/"
DEBIAN_INSTALLER_ISO="https://cdimage.debian.org/cdimage/archive/13.3.0/amd64/iso-cd/debian-13.3.0-amd64-netinst.iso"

# The build uses Debian's signed package archive via snapshot.debian.org.
DEBIAN_PACKAGE_ARCHIVE="https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/"
DEBIAN_BINARY_ARCHIVE="https://deb.debian.org/debian"
DEBIAN_SECURITY_ARCHIVE="https://security.debian.org/debian-security"
